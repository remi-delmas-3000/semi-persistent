(sort E)
(function a () E)
(function b () E)
(function c () E)
(function g (E) E)
(function Add (E) E :assoc-comm)
(rewrite (Add (a) ..r) (Add (g (a)) ..r))
(let t (Add (a) (b) (c)))
(run 1)
(check-eq t (Add (g (a)) (b) (c)))
